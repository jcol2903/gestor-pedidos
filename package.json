{
  "name": "mi-espacio-kirala",
  "version": "1.0.0",
  "description": "Monorepo para gestión local de Kirala Tortas y Amigurumis",
  "main": "index.js",
  "scripts": {
    "backend": "npm start --prefix backend-server",
    "frontend": "npm run dev --prefix frontend-desktop",
    "mobile": "npm start --prefix mobile-app",
    "dev": "concurrently --kill-others-on-fail -n \"BACKEND,FRONTEND\" -c \"magenta.bold,cyan.bold\" \"npm run backend\" \"npm run frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}